{
  "name": "dsh-multimedia",
  "version": "0.2.0",
  "description": "DSH 多媒体生成插件：多渠道（fal.ai / ElevenLabs / ComfyUI）文生图、文生视频、TTS 语音合成，会话 tab 提供生成页面 + 作品库 + 渠道配置，host 侧提供生成 API 与 agent 工具，支持结果下载/复制/导出。",
  "type": "module",
  "main": "index.mjs",
  "files": [
    "index.mjs",
    "lib",
    "cordis.patch.yml",
    "src",
    "scripts",
    "docs",
    "test",
    "README.md"
  ],
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node test/run.mjs && node --test test/host-smoke.test.mjs",
    "test:unit": "node test/run.mjs",
    "test:host-smoke": "node --test test/host-smoke.test.mjs"
  },
  "exports": {
    ".": "./index.mjs",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5.0.0"
  }
}
